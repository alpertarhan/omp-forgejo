{
  "name": "omp-forgejo",
  "version": "0.11.1",
  "description": "Multi-server Forgejo workflows, watches, reviews, and Actions tools for omp",
  "type": "module",
  "author": {
    "name": "Alper Tarhan",
    "url": "https://github.com/alpertarhan"
  },
  "homepage": "https://github.com/alpertarhan/omp-forgejo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpertarhan/omp-forgejo.git"
  },
  "bugs": {
    "url": "https://github.com/alpertarhan/omp-forgejo/issues"
  },
  "keywords": [
    "omp-package",
    "omp",
    "omp-extension",
    "oh-my-pi",
    "forgejo",
    "gitea",
    "coding-agent",
    "developer-tools",
    "multi-server"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "examples",
    "skills",
    "src",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "bun run check"
  },
  "omp": {
    "extensions": [
      "./extensions/forgejo/index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.1.13",
    "@oh-my-pi/pi-coding-agent": "18.1.13",
    "@oh-my-pi/pi-tui": "18.1.13",
    "@oh-my-pi/omptype": "18.1.13",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "4.1.4",
    "typebox": "1.3.25",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
